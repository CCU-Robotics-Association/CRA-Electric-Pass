/* 电子通行证公共硬件 */
#include "suniv-f1c100s.dtsi"
#include <dt-bindings/input/input.h> 
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/display/st7701initseq.h>

/ {
	/* Model */
	model = "CRA Electric Pass";
	compatible = "cra,electric-pass",
	         "allwinner,suniv-f1c200s",
			 "allwinner,suniv-f1c100s";

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* U-Boot 传入实际:根文件系统位置|串口控制台|UBI/UBIFS参数|NAND分区参数 */
		/* bootargs 仅作占位 */
		bootargs = "Don`t give yourselves to those unnatural men -- you are not machines -- you are men";
	};

	/* LCD panel */
	/* DE → TCON0 → RGB LCD panel*/
	/* RGB565 总线 | 384*640 | 60Hz */
	panel: panel {
		compatible = "lattland,mostima", "simple-panel";

		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			panel_input: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&tcon0_out_lcd>;
			};
		};
	};

	/* Regulayor */ 	
	/* vcc3v3 - 3.3V */
	/* lradc_vref - 3.0V */
	reg_vcc3v3: vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	reg_lradc: reg_lradc {
		compatible = "regulator-fixed";
		regulator-name = "lradc_vref";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
	};

	/* BackLight */
	/* PWM.T = 100kHz */
	/* default = 6 => 128 */
	backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 10000 0>;
		

		brightness-levels = <0 4 8 16 32 64 128 196 220 255>;
		default-brightness-level = <6>;
	};

	/* ST7701 Init */
	st7701initseq: st7701initseq {
		compatible = "lattland,st7701-initseq";
		status = "disabled";
	};
};

/* GPIO */
&pio{

	spi1_pins: spi1-pins {
		pins = "PE7","PE8", "PE9", "PE10";
		function = "spi1";
		bias-pull-up;
	};

	rtp_pins_0: rtp-pins-0 {
		pins = "PA0";
		function = "rtp";
	};

    rtp_pins_01: rtp-pins-01 {
		pins = "PA0","PA1";
		function = "rtp";
	};
	
	lcd_rgb565_no_de_pins: lcd-rgb565-no-de-pins {
		pins = "PD1", "PD2", "PD3", "PD4", "PD5",
			"PD6", "PD7", "PD8", "PD9", "PD10", "PD11", 
			"PD13", "PD14", "PD15", "PD16", "PD17",
			"PD18", "PD20", "PD21";
		function = "lcd";
	};

    i2s_pins_pe: i2s-pins-pe {
		pins = "PE3","PE5","PE6","PA1";
		function = "i2s";
	};

    i2s_pins_pa: i2s-pins-pa {
		pins = "PE3","PA2","PA3","PA1";
		function = "i2s";
	};

};

/* PWM */
&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pe_pins>;
	status = "okay";
};

/* SPI-NAND */
/* u-boot | 0x000000 | 1MiB */
/* boot | 0x100000 | 6MiB */
/* rootfs | 0x700000 | 121MiB */
&spi0 {
	status = "okay";

	spi-nand@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <80000000>;
		status = "okay";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x100000>;
				read-only;
			};

			partition@1 {
				label = "boot";
				reg = <0x100000 0x600000>;
			};

			partition@2 {
				label = "rootfs";
				reg = <0x700000 0x7900000>;
			};
		};
	};
};

/* SPI1 */
&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	status = "disabled";
	spidev@0 {
	/* Same as "spidev" but without errors at boot. Search "buggy DT" to understand */
	   compatible = "rohm,dh2228fv";	
	   spi-max-frequency = <80000000>;
	   reg = <0>;
	};
};

/* UART */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pe_pins>;
	status = "okay";
};
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pa_pins>;
	status = "disabled";
};
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pe_pins>;
	status = "disabled";
};

/* SD */
&mmc0 {	
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	status = "okay";
	broken-cd;
};

/* USB */
&otg_sram {
	status = "okay";
};

&usb_otg {
	dr_mode = "otg"; 
	status = "okay";
};

&usbphy {
	status = "okay";
};

/* Video Engine */
&cedar_ve {
	status = "okay";
};

&ion {
	status = "okay";
};

&de {
	status = "okay";
};

&fe0 {
	status = "okay";
};

&be0 {
	status = "okay";
};

&tve0 {
	status = "disabled";
};

&rtp {
	status = "okay";
	pinctrl-0 = <&rtp_pins_0>;
	pinctrl-names = "default";
};

&tcon0 {
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rgb565_no_de_pins>;
	status = "okay";
};

&tcon0_out {
	tcon0_out_lcd: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&panel_input>;
	};
};

&lradc {
	vref-supply = <&reg_lradc>;
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pd_pins>;
	status = "disabled";
};
