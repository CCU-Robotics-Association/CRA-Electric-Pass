/dts-v1/;
#include "suniv-f1c100s.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "CRA Electric Pass";
	compatible = "cra,electric-pass",
		     "allwinner,suniv-f1c100s",
		     "allwinner,suniv";

	aliases {
		serial0 = &uart0;
		spi0 = &spi0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&otg_sram {
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins_a>;
	status = "okay";

	spi-nand@0 {
		reg = <0>;
		compatible = "spi-nand";
		spi-max-frequency = <80000000>;
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins_a>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins_a>;
	status = "okay";
};

&usb_otg {
	status = "okay";
};

&usbphy {
	status = "okay";
};

&mmc0 {
	status = "okay";
};

&mmc2 {
	/*
	 * MMC1 uses PC0-PC2, which conflicts with SPI0 on PC0-PC3.
	 * This board boots from SPI-NAND, so keep the second MMC disabled.
	 */
	status = "disabled";
};
