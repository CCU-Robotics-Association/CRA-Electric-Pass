config BR2_PACKAGE_LIBCEDARX
	depends on BR2_PACKAGE_LIBCEDARC
	depends on BR2_PACKAGE_OPENSSL
	bool "libcedarx"
	help
		Third-party Allwinner CedarX multimedia middleware. This is an
		external dependency and is not maintained or authored by CRA.

		https://github.com/rhodesepass/libcedarx

comment "libcedarx needs libcedarc"
	depends on !BR2_PACKAGE_LIBCEDARC
